# PostgreSQL
POSTGRES_USER=lead
POSTGRES_PASSWORD=lead
POSTGRES_DB=leadintel

# Go API
# Host-run API (go run) reaches the compose Postgres on localhost.
DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel?sslmode=disable
API_ADDR=:8080
MIGRATE_ON_START=true
LOG_LEVEL=info
# Protects /api/admin/* (at least 24 characters). Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-with-output-of-openssl-rand-hex-24
# AI service address (host-run API → AI service on localhost or the compose port).
AI_GRPC_ADDR=localhost:50051
ANALYSIS_WORKERS=2
ANALYSIS_TIMEOUT=300s
AI_DISPATCH_ATTEMPTS=3

# AI service (Python)
# Your OpenAI-compatible LLM server. From inside Docker, use host.docker.internal
# to reach a server on this machine, e.g. http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
LLM_TIMEOUT_SECONDS=120
MAX_CONCURRENT_ANALYSES=4
# Fetch the lead's homepage to ground company insights (SPEC.md §9.7).
WEB_FETCH_ENABLED=true

# Store integration tests (go test). Uses a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel_test?sslmode=disable
