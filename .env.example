# PostgreSQL
POSTGRES_USER=lead
POSTGRES_PASSWORD=lead
POSTGRES_DB=leadintel

# Docker Compose sets DATABASE_URL and AI_GRPC_ADDR for its own containers, so the
# localhost values below only apply to services run on the host (make api, make ai).

# Go API
# Host-run API (go run) reaches the compose Postgres on localhost.
DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel?sslmode=disable
API_ADDR=:8080
MIGRATE_ON_START=true
LOG_LEVEL=info
# Protects /api/admin/* (at least 24 characters). Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-with-output-of-openssl-rand-hex-24
# AI service address (host-run API → AI service on localhost or the compose port).
AI_GRPC_ADDR=localhost:50051
ANALYSIS_WORKERS=2
ANALYSIS_TIMEOUT=300s
AI_DISPATCH_ATTEMPTS=3

# AI service (Python)
# Your OpenAI-compatible LLM server. For the full Docker stack, use
# host.docker.internal to reach a server on this machine (localhost inside a
# container is the container itself). For a host-run AI service (make ai), use
# http://localhost:11434/v1 instead.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
LLM_TIMEOUT_SECONDS=120
MAX_CONCURRENT_ANALYSES=4
# Ideal customer profile that analyze_fit scores leads against (max 2000 characters).
# Leave empty to use the built-in default shown here. Keep it on one line, unquoted.
ICP_DESCRIPTION=B2B SaaS or technology-enabled service companies with 50-1000 employees that sell to other businesses, have a dedicated sales or revenue team, and are investing in growth (hiring, new markets, or new product lines).
# Fetch the lead's homepage to ground company insights (SPEC.md §9.7).
WEB_FETCH_ENABLED=true

# Host ports of the Docker stack (all bound to 127.0.0.1). Change them to run the
# stack next to services already running on the host.
# WEB_PORT=5173
# API_PORT=8080
# AI_PORT=50051
# POSTGRES_PORT=5432

# Store integration tests (go test). Uses a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel_test?sslmode=disable
