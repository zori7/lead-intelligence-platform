# PostgreSQL
POSTGRES_USER=lead
POSTGRES_PASSWORD=lead
POSTGRES_DB=leadintel

# Go API
# Host-run API (go run) reaches the compose Postgres on localhost.
DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel?sslmode=disable
API_ADDR=:8080
MIGRATE_ON_START=true
LOG_LEVEL=info

# Store integration tests (go test). Uses a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgres://lead:lead@localhost:5432/leadintel_test?sslmode=disable
